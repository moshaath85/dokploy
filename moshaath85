<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Moshaath App - Telehealth App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Custom styles that can't be done with Tailwind */
        .video-call-container {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        
        .doctor-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        
        .appointment-time.selected {
            background-color: #4f46e5;
            color: white;
        }
        
        /* Animation for video call button */
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        
        .pulse-animation {
            animation: pulse 2s infinite;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans">
    <!-- Header/Navbar -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <div class="w-10 h-10 bg-indigo-600 rounded-full flex items-center justify-center">
                    <i class="fas fa-heartbeat text-white text-xl"></i>
                </div>
                <h1 class="text-xl font-bold text-indigo-600">Moshaath app</h1>
            </div>
            <div class="flex items-center space-x-4">
                <button class="text-gray-600 hover:text-indigo-600">
                    <i class="fas fa-bell text-xl"></i>
                </button>
                <div class="w-8 h-8 rounded-full bg-indigo-100 flex items-center justify-center">
                    <i class="fas fa-user text-indigo-600"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-6">
        <!-- Search and Filter -->
        <div class="mb-8">
            <div class="relative mb-4">
                <input type="text" placeholder="Search doctors, specialties..." 
                       class="w-full py-3 px-4 pl-12 rounded-full border border-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
                <i class="fas fa-search absolute left-4 top-3.5 text-gray-400"></i>
            </div>
            <div class="flex overflow-x-auto space-x-3 pb-2">
                <button class="px-4 py-2 bg-indigo-600 text-white rounded-full whitespace-nowrap">All</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full whitespace-nowrap">General</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full whitespace-nowrap">Pediatrics</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full whitespace-nowrap">Cardiology</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full whitespace-nowrap">Dermatology</button>
                <button class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full whitespace-nowrap">Gynecology</button>
            </div>
        </div>

        <!-- Upcoming Appointment -->
        <div class="mb-8">
            <h2 class="text-xl font-bold mb-4">Upcoming Appointment</h2>
            <div class="bg-white rounded-xl shadow-md p-4">
                <div class="flex items-center space-x-4">
                    <div class="w-16 h-16 rounded-full bg-indigo-100 flex items-center justify-center">
                        <i class="fas fa-user-md text-indigo-600 text-2xl"></i>
                    </div>
                    <div class="flex-1">
                        <h3 class="font-bold">Dr. Sarah Johnson</h3>
                        <p class="text-gray-600">General Practitioner</p>
                        <div class="flex items-center mt-1">
                            <i class="fas fa-star text-yellow-400 mr-1"></i>
                            <span class="text-gray-700">4.8 (120 reviews)</span>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center">
                    <div>
                        <p class="text-gray-500 text-sm">Appointment Time</p>
                        <p class="font-medium">Today, 2:30 PM</p>
                    </div>
                    <button class="bg-indigo-600 text-white px-4 py-2 rounded-lg flex items-center pulse-animation">
                        <i class="fas fa-video mr-2"></i> Join Call
                    </button>
                </div>
            </div>
        </div>

        <!-- Available Doctors -->
        <div class="mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold">Available Doctors</h2>
                <button class="text-indigo-600">See All</button>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Doctor Card 1 -->
                <div class="bg-white rounded-xl shadow-md p-4 doctor-card transition duration-300">
                    <div class="flex items-center space-x-4">
                        <div class="w-14 h-14 rounded-full bg-indigo-100 flex items-center justify-center">
                            <i class="fas fa-user-md text-indigo-600 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold">Dr. Michael Chen</h3>
                            <p class="text-gray-600">Cardiologist</p>
                        </div>
                    </div>
                    <div class="flex items-center mt-3">
                        <i class="fas fa-star text-yellow-400 mr-1"></i>
                        <span class="text-gray-700">4.9 (85 reviews)</span>
                    </div>
                    <div class="mt-4 flex justify-between items-center">
                        <div>
                            <p class="text-gray-500 text-sm">Available Today</p>
                            <p class="font-medium">From 9:00 AM</p>
                        </div>
                        <button class="bg-indigo-600 text-white px-3 py-1.5 rounded-lg text-sm">
                            Book Now
                        </button>
                    </div>
                </div>

                <!-- Doctor Card 2 -->
                <div class="bg-white rounded-xl shadow-md p-4 doctor-card transition duration-300">
                    <div class="flex items-center space-x-4">
                        <div class="w-14 h-14 rounded-full bg-indigo-100 flex items-center justify-center">
                            <i class="fas fa-user-md text-indigo-600 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold">Dr. Emily Wilson</h3>
                            <p class="text-gray-600">Pediatrician</p>
                        </div>
                    </div>
                    <div class="flex items-center mt-3">
                        <i class="fas fa-star text-yellow-400 mr-1"></i>
                        <span class="text-gray-700">4.7 (64 reviews)</span>
                    </div>
                    <div class="mt-4 flex justify-between items-center">
                        <div>
                            <p class="text-gray-500 text-sm">Available Today</p>
                            <p class="font-medium">From 10:30 AM</p>
                        </div>
                        <button class="bg-indigo-600 text-white px-3 py-1.5 rounded-lg text-sm">
                            Book Now
                        </button>
                    </div>
                </div>

                <!-- Doctor Card 3 -->
                <div class="bg-white rounded-xl shadow-md p-4 doctor-card transition duration-300">
                    <div class="flex items-center space-x-4">
                        <div class="w-14 h-14 rounded-full bg-indigo-100 flex items-center justify-center">
                            <i class="fas fa-user-md text-indigo-600 text-xl"></i>
                        </div>
                        <div>
                            <h3 class="font-bold">Dr. Robert Garcia</h3>
                            <p class="text-gray-600">Dermatologist</p>
                        </div>
                    </div>
                    <div class="flex items-center mt-3">
                        <i class="fas fa-star text-yellow-400 mr-1"></i>
                        <span class="text-gray-700">4.8 (92 reviews)</span>
                    </div>
                    <div class="mt-4 flex justify-between items-center">
                        <div>
                            <p class="text-gray-500 text-sm">Available Today</p>
                            <p class="font-medium">From 1:00 PM</p>
                        </div>
                        <button class="bg-indigo-600 text-white px-3 py-1.5 rounded-lg text-sm">
                            Book Now
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Special Offers -->
        <div class="mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold">Special Offers</h2>
                <button class="text-indigo-600">See All</button>
            </div>
            <div class="bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl p-4 text-white">
                <h3 class="font-bold text-lg mb-1">First Consultation Free</h3>
                <p class="mb-3">Get your first video consultation with any doctor for free!</p>
                <button class="bg-white text-indigo-600 px-4 py-2 rounded-lg font-medium">
                    Claim Offer
                </button>
            </div>
        </div>
    </main>

    <!-- Bottom Navigation -->
    <nav class="bg-white shadow-lg fixed bottom-0 left-0 right-0 z-50">
        <div class="container mx-auto px-4 py-2 flex justify-around">
            <button class="flex flex-col items-center text-indigo-600">
                <i class="fas fa-home text-xl"></i>
                <span class="text-xs mt-1">Home</span>
            </button>
            <button class="flex flex-col items-center text-gray-500">
                <i class="fas fa-calendar-alt text-xl"></i>
                <span class="text-xs mt-1">Appointments</span>
            </button>
            <button class="flex flex-col items-center text-gray-500">
                <i class="fas fa-comment-medical text-xl"></i>
                <span class="text-xs mt-1">Messages</span>
            </button>
            <button class="flex flex-col items-center text-gray-500">
                <i class="fas fa-user text-xl"></i>
                <span class="text-xs mt-1">Profile</span>
            </button>
        </div>
    </nav>

    <!-- Appointment Booking Modal (Hidden by default) -->
    <div id="bookingModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
        <div class="bg-white rounded-xl w-full max-w-md mx-4 max-h-[90vh] overflow-y-auto">
            <div class="p-4 border-b border-gray-200 flex justify-between items-center">
                <h3 class="font-bold text-lg">Book Appointment</h3>
                <button id="closeModal" class="text-gray-500">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="p-4">
                <div class="flex items-center space-x-4 mb-6">
                    <div class="w-16 h-16 rounded-full bg-indigo-100 flex items-center justify-center">
                        <i class="fas fa-user-md text-indigo-600 text-2xl"></i>
                    </div>
                    <div>
                        <h4 class="font-bold" id="doctorName">Dr. Michael Chen</h4>
                        <p class="text-gray-600" id="doctorSpecialty">Cardiologist</p>
                        <div class="flex items-center mt-1">
                            <i class="fas fa-star text-yellow-400 mr-1"></i>
                            <span class="text-gray-700">4.9 (85 reviews)</span>
                        </div>
                    </div>
                </div>

                <div class="mb-6">
                    <h4 class="font-bold mb-3">Select Date</h4>
                    <div class="grid grid-cols-7 gap-2 text-center">
                        <div class="py-2 rounded-lg bg-indigo-600 text-white">Today</div>
                        <div class="py-2 rounded-lg bg-gray-100">Tue</div>
                        <div class="py-2 rounded-lg bg-gray-100">Wed</div>
                        <div class="py-2 rounded-lg bg-gray-100">Thu</div>
                        <div class="py-2 rounded-lg bg-gray-100">Fri</div>
                        <div class="py-2 rounded-lg bg-gray-100">Sat</div>
                        <div class="py-2 rounded-lg bg-gray-100">Sun</div>
                    </div>
                </div>

                <div class="mb-6">
                    <h4 class="font-bold mb-3">Available Time Slots</h4>
                    <div class="grid grid-cols-3 gap-3">
                        <button class="appointment-time py-2 rounded-lg border border-gray-300">9:00 AM</button>
                        <button class="appointment-time py-2 rounded-lg border border-gray-300">10:30 AM</button>
                        <button class="appointment-time py-2 rounded-lg border border-gray-300">11:15 AM</button>
                        <button class="appointment-time py-2 rounded-lg border border-gray-300">1:00 PM</button>
                        <button class="appointment-time py-2 rounded-lg border border-gray-300">2:45 PM</button>
                        <button class="appointment-time py-2 rounded-lg border border-gray-300">4:30 PM</button>
                    </div>
                </div>

                <div class="mb-6">
                    <h4 class="font-bold mb-3">Consultation Type</h4>
                    <div class="flex space-x-3">
                        <button class="flex-1 py-2 rounded-lg border border-indigo-600 text-indigo-600 font-medium">
                            Video Call
                        </button>
                        <button class="flex-1 py-2 rounded-lg border border-gray-300 text-gray-500">
                            Voice Call
                        </button>
                    </div>
                </div>

                <button id="confirmBooking" class="w-full bg-indigo-600 text-white py-3 rounded-lg font-medium">
                    Confirm Booking ($50)
                </button>
            </div>
        </div>
    </div>

    <!-- Video Call Screen (Hidden by default) -->
    <div id="videoCallScreen" class="fixed inset-0 bg-black z-50 hidden">
        <div class="video-call-container h-full flex flex-col">
            <!-- Doctor Video -->
            <div class="flex-1 flex items-center justify-center relative">
                <div class="w-full h-full bg-gray-800 flex items-center justify-center">
                    <div class="text-center text-white">
                        <div class="w-24 h-24 rounded-full bg-indigo-100 mx-auto mb-4 flex items-center justify-center">
                            <i class="fas fa-user-md text-indigo-600 text-3xl"></i>
                        </div>
                        <h3 class="text-xl font-bold" id="callDoctorName">Dr. Sarah Johnson</h3>
                        <p class="text-gray-300">Connecting...</p>
                    </div>
                </div>
                
                <!-- User Video (Picture-in-picture) -->
                <div class="absolute bottom-4 right-4 w-32 h-48 bg-gray-700 rounded-lg overflow-hidden">
                    <div class="w-full h-full flex items-center justify-center">
                        <i class="fas fa-user text-white text-2xl"></i>
                    </div>
                </div>
            </div>
            
            <!-- Call Controls -->
            <div class="py-6 px-4 bg-gray-900 flex justify-center space-x-8">
                <button class="w-12 h-12 rounded-full bg-gray-700 text-white flex items-center justify-center">
                    <i class="fas fa-microphone-slash text-xl"></i>
                </button>
                <button class="w-12 h-12 rounded-full bg-gray-700 text-white flex items-center justify-center">
                    <i class="fas fa-video text-xl"></i>
                </button>
                <button id="endCall" class="w-14 h-14 rounded-full bg-red-600 text-white flex items-center justify-center">
                    <i class="fas fa-phone text-xl"></i>
                </button>
                <button class="w-12 h-12 rounded-full bg-gray-700 text-white flex items-center justify-center">
                    <i class="fas fa-comment-medical text-xl"></i>
                </button>
                <button class="w-12 h-12 rounded-full bg-gray-700 text-white flex items-center justify-center">
                    <i class="fas fa-ellipsis-h text-xl"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Booking Confirmation (Hidden by default) -->
    <div id="confirmationModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden">
        <div class="bg-white rounded-xl w-full max-w-md mx-4 p-6 text-center">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-check text-green-500 text-2xl"></i>
            </div>
            <h3 class="font-bold text-xl mb-2">Appointment Booked!</h3>
            <p class="text-gray-600 mb-6">Your appointment with <span id="confirmedDoctor" class="font-medium">Dr. Michael Chen</span> is confirmed for <span id="confirmedTime" class="font-medium">Today, 9:00 AM</span>.</p>
            <button id="closeConfirmation" class="w-full bg-indigo-600 text-white py-3 rounded-lg font-medium">
                Done
            </button>
        </div>
    </div>

    <script>
        // Booking Modal Functionality
        document.querySelectorAll('.doctor-card button').forEach(button => {
            button.addEventListener('click', function() {
                const card = this.closest('.doctor-card');
                const name = card.querySelector('h3').textContent;
                const specialty = card.querySelector('p').textContent;
                
                document.getElementById('doctorName').textContent = name;
                document.getElementById('doctorSpecialty').textContent = specialty;
                document.getElementById('bookingModal').classList.remove('hidden');
            });
        });

        // Close Modal
        document.getElementById('closeModal').addEventListener('click', function() {
            document.getElementById('bookingModal').classList.add('hidden');
        });

        // Time Slot Selection
        document.querySelectorAll('.appointment-time').forEach(time => {
            time.addEventListener('click', function() {
                document.querySelectorAll('.appointment-time').forEach(t => t.classList.remove('selected'));
                this.classList.add('selected');
            });
        });

        // Confirm Booking
        document.getElementById('confirmBooking').addEventListener('click', function() {
            const selectedTime = document.querySelector('.appointment-time.selected');
            if (selectedTime) {
                document.getElementById('bookingModal').classList.add('hidden');
                
                // Set confirmation details
                document.getElementById('confirmedDoctor').textContent = document.getElementById('doctorName').textContent;
                document.getElementById('confirmedTime').textContent = 'Today, ' + selectedTime.textContent;
                
                // Show confirmation
                document.getElementById('confirmationModal').classList.remove('hidden');
            } else {
                alert('Please select a time slot');
            }
        });

        // Close Confirmation
        document.getElementById('closeConfirmation').addEventListener('click', function() {
            document.getElementById('confirmationModal').classList.add('hidden');
        });

        // Join Video Call
        document.querySelector('.pulse-animation').addEventListener('click', function() {
            document.getElementById('callDoctorName').textContent = 'Dr. Sarah Johnson';
            document.getElementById('videoCallScreen').classList.remove('hidden');
        });

        // End Video Call
        document.getElementById('endCall').addEventListener('click', function() {
            document.getElementById('videoCallScreen').classList.add('hidden');
        });

        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
            if (event.target === document.getElementById('bookingModal')) {
                document.getElementById('bookingModal').classList.add('hidden');
            }
            if (event.target === document.getElementById('confirmationModal')) {
                document.getElementById('confirmationModal').classList.add('hidden');
            }
        });
    </script>
</body>
</html>
